{
  "name": "vite-start-antd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:check": "vp check",
    "agent:format": "vp fmt",
    "agent:lint": "vp lint && node scripts/lint-tailwind.ts",
    "agent:lint:ci": "actionlint",
    "agent:lint:tailwind": "node scripts/lint-tailwind.ts",
    "agent:test:e2e": "playwright test --reporter=line",
    "agent:test:unit": "vp test run --reporter=tap-flat --no-color",
    "agent:typecheck": "tsc -b --pretty false",
    "agent:verify:gate": "vpr agent:verify:unit && vp build && vpr agent:test:e2e",
    "agent:verify:inner": "vpr agent:typecheck && vpr agent:lint",
    "agent:verify:unit": "vpr agent:verify:inner && vpr agent:test:unit",
    "check": "vp check && vpr lint:tailwind && vpr check:deadcode && vp test && vp build",
    "check:deadcode": "knip",
    "lint:ci": "actionlint",
    "lint:tailwind": "node scripts/lint-tailwind.ts",
    "lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "test:e2e": "playwright test",
    "test:setup": "playwright install chromium",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "antd": "6.6.5",
    "dayjs": "1.11.23",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "catalog:",
    "knip": "6.39.0",
    "oxc-transform-react": "0.145.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.3.0",
    "vscode-languageserver-protocol": "3.18.4"
  },
  "engines": {
    "node": "24.21.0"
  },
  "knip": {
    "ignoreBinaries": [
      "actionlint"
    ],
    "ignoreDependencies": [
      "@tailwindcss/language-server"
    ],
    "playwright": true
  }
}
