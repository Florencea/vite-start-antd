{
  "name": "vite-start-antd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:lint": "npm run agent:lint:eslint && npm run agent:lint:tailwind",
    "agent:lint:eslint": "eslint --no-inline-config --no-color --max-warnings 0",
    "agent:lint:eslint:fix": "eslint --no-inline-config --no-color --fix --max-warnings 0",
    "agent:lint:fix": "npm run agent:lint:eslint:fix && npm run agent:lint:tailwind:fix",
    "agent:lint:tailwind": "node scripts/lint-tailwind.ts",
    "agent:lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "agent:test:e2e": "playwright test --reporter=line",
    "agent:test:unit": "vitest run --reporter=tap-flat --no-color",
    "agent:typecheck": "tsc -b --pretty false",
    "agent:verify:gate": "npm run agent:verify:unit && npm run build && npm run agent:test:e2e",
    "agent:verify:inner": "npm run agent:typecheck && npm run agent:lint",
    "agent:verify:unit": "npm run agent:verify:inner && npm run agent:test:unit",
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run lint:tailwind && npm run format:check && npm run check:deadcode && npm run test && npm run build",
    "check:deadcode": "knip",
    "dev": "vite",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:tailwind": "node scripts/lint-tailwind.ts",
    "lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:setup": "playwright install chromium",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.36",
    "antd": "6.6.4",
    "dayjs": "1.11.23",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.38",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "knip": "6.35.1",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vitest-browser-react": "2.3.0",
    "vscode-languageserver-protocol": "3.18.3"
  },
  "engines": {
    "node": "24.21.0"
  },
  "knip": {
    "ignoreDependencies": [
      "@tailwindcss/language-server"
    ],
    "playwright": true
  }
}
